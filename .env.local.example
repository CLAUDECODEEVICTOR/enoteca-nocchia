# Chiave API Anthropic (Claude Vision)
ANTHROPIC_API_KEY=sk-ant-...

# Database Neon (archivio scansioni + feedback)
DATABASE_URL=postgresql://...

# PIN di accesso all'app, richiesto ai clienti sul tablet
APP_PIN=2222

# PIN amministratore per /archivio e /feedback. Tienilo diverso e più lungo di APP_PIN.
ADMIN_PIN=2222

# Segreto usato per firmare i cookie di sessione. Stringa casuale lunga, mai condivisa.
# Generane uno con: openssl rand -hex 32
AUTH_SECRET=
